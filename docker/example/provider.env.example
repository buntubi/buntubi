# The provider's settings. Every IDP_* setting is in idp/src/buntubi/config.py.
IDP_ISSUER=http://localhost:5010
# At least 32 characters. Never change it: it signs sessions and encrypts authenticator secrets.
IDP_SECRET_KEY=
IDP_SECURE_COOKIES=true
# Local only: emails, sign-in codes included, go to the log. Refused with a public issuer.
IDP_EMAIL_TEST_MODE=true
IDP_RESEND_API_KEY=
IDP_EMAIL_FROM=
IDP_RATE_LIMIT_STORAGE=memory://
IDP_BRAND_NAME=Buntubi
