# The identity provider, and where this console is served.
IDP_URL=http://localhost:5010
APP_URL=http://localhost:3420
# From `flask clients create --client-id owner-console --type confidential ...` in idp/.
CONSOLE_CLIENT_ID=owner-console
CONSOLE_CLIENT_SECRET=
# At least 32 characters: encrypts the session cookie.
SESSION_SECRET=
