# The identity provider, and where this portal is served.
IDP_URL=http://localhost:5010
APP_URL=http://localhost:3410
# Written by `flask platform setup` in idp/ (see idp/platform.example.toml).
PORTAL_CLIENT_ID=developer-portal
PORTAL_CLIENT_SECRET=
# At least 32 characters: encrypts the session cookie.
SESSION_SECRET=
