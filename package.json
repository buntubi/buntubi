{
  "name": "identity-provider",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "setup": "./scripts/install.sh",
    "dev": "./scripts/dev.sh",
    "idp": "./scripts/idp.sh",
    "migrate": "cd idp && ../.venv/bin/alembic upgrade head",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r --filter '!@idp/skin' exec tsc --noEmit -p .",
    "version": "changeset version && node scripts/sync-version.mjs && pnpm install --lockfile-only",
    "release": "pnpm --filter @buntubi/sdk --filter create-buntubi build && changeset publish",
    "images:dev": "node scripts/dev-images.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.0.0"
    }
  }
}
