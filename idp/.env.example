# Copy to .env. Every setting is in src/idp/config.py.
# The platform's brand, shown by the sign-in pages, emails, the portal and the console.
IDP_BRAND_NAME=
IDP_BRAND_ACCENT=
IDP_BRAND_LOGO_URL=
IDP_BRAND_SUPPORT_EMAIL=
IDP_BRAND_PRIVACY_URL=
IDP_BRAND_TERMS_URL=
IDP_ISSUER=http://localhost:5010
IDP_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/idp
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
IDP_SECRET_KEY=
IDP_SIGNING_KEYS_DIR=keys
# Cookies marked Secure work on http://localhost in browsers.
IDP_SECURE_COOKIES=true
# Off: emails go through Resend. On: they are logged.
IDP_EMAIL_TEST_MODE=true
IDP_RESEND_API_KEY=
IDP_EMAIL_FROM=
IDP_CORS_ORIGINS=["http://localhost:3000"]
