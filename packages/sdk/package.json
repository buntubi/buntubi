{
  "name": "@buntubi/sdk",
  "version": "0.4.0",
  "description": "Types, API clients, form schemas and the plugin helpers for building on the identity provider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buntubi/buntubi.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./types": "./src/types.ts",
    "./developer": "./src/developer.ts",
    "./admin": "./src/admin.ts",
    "./roles": "./src/roles.ts",
    "./plugins": "./src/plugins.ts",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./schemas/users": "./src/schemas/users.ts",
    "./schemas/organizations": "./src/schemas/organizations.ts",
    "./schemas/catalogue": "./src/schemas/catalogue.ts",
    "./schemas/team": "./src/schemas/team.ts",
    "./schemas/apps": "./src/schemas/apps.ts",
    "./account": "./src/account.ts",
    "./schemas/account": "./src/schemas/account.ts",
    "./webauthn": "./src/webauthn.ts",
    "./view": "./src/view.ts",
    "./navigation": "./src/navigation.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fluixi/di": "^1.0.0-alpha.99",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fluixi/di": "^1.0.0-alpha.99",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "./developer": {
        "types": "./dist/developer.d.ts",
        "default": "./dist/developer.js"
      },
      "./admin": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "./roles": {
        "types": "./dist/roles.d.ts",
        "default": "./dist/roles.js"
      },
      "./plugins": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./schemas/users": {
        "types": "./dist/schemas/users.d.ts",
        "default": "./dist/schemas/users.js"
      },
      "./schemas/organizations": {
        "types": "./dist/schemas/organizations.d.ts",
        "default": "./dist/schemas/organizations.js"
      },
      "./schemas/catalogue": {
        "types": "./dist/schemas/catalogue.d.ts",
        "default": "./dist/schemas/catalogue.js"
      },
      "./schemas/team": {
        "types": "./dist/schemas/team.d.ts",
        "default": "./dist/schemas/team.js"
      },
      "./schemas/apps": {
        "types": "./dist/schemas/apps.d.ts",
        "default": "./dist/schemas/apps.js"
      },
      "./account": {
        "types": "./dist/account.d.ts",
        "default": "./dist/account.js"
      },
      "./schemas/account": {
        "types": "./dist/schemas/account.d.ts",
        "default": "./dist/schemas/account.js"
      },
      "./webauthn": {
        "types": "./dist/webauthn.d.ts",
        "default": "./dist/webauthn.js"
      },
      "./view": {
        "types": "./dist/view.d.ts",
        "default": "./dist/view.js"
      },
      "./navigation": {
        "types": "./dist/navigation.d.ts",
        "default": "./dist/navigation.js"
      }
    }
  }
}
