# Never in an image: secrets, keys, local settings, builds and caches.
**/.env
**/.env.*
!**/.env.example
idp/keys
idp/platform.toml
**/node_modules
**/dist
idp/src/buntubi/static/idp
.venv
**/__pycache__
**/*.egg-info
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
.git
**/.DS_Store
docs
# Dockerfiles are read separately; in the context they would only break the cache.
docker
idp/tests
# UI plugins mounted for a local run; a deployment mounts its own.
apps/*/ui-plugins
